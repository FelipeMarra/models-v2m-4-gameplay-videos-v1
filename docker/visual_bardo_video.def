# Last release of a nvidia container of torch 2.1 since Audiocraft depends on torch 2.1
Bootstrap: docker
From: nvcr.io/nvidia/pytorch:23.10-py3

%setup
# Bind host folder to the container. In this way I'm only working on the host files
# The container will be just like an isoladed env to run the code
export SINGULARITY_BIND="~/dados/repos/visual-bardo-video:/app/code,~/dados/datasets/vmdb:/app/dataset,~/dados/xps:/app/code"

# %environment

%post
    apt-get update && \
    apt-get -y upgrade

    # I usually work from a /app folder, like "WORKDIR /app" on docker
    mkdir -p /app

    # Audiocraft also depends on python 3.9
    # Beyond that, the docs ask for a Conda env when using the metrics
    # Crating a miniconda env with python 3.9
    mkdir -p ~/miniconda3 && \
    wget https://repo.anaconda.com/miniconda/Miniconda3-py39_25.3.1-1-Linux-x86_64.sh -O ~/miniconda3/miniconda.sh && \
    bash ~/miniconda3/miniconda.sh -b -u -p ~/miniconda3 && \
    rm ~/miniconda3/miniconda.sh

    source ~/miniconda3/bin/activate
    echo "$(conda info --envs)"

    # install av and therefore ffmpeg
    conda install av==11.0.0 -c conda-forge
    # install torch 2.1 (should be in the requirements? but the docs ask to install, so...)
    python3 -m pip install 'torch==2.1.0'

%runscript
    source ~/miniconda3/bin/activate
    echo "$(conda info --envs)"
    # intsall audiocraft
    python3 -m pip install -e /app/code
    # uninstall apex because of https://github.com/facebookresearch/fairseq/issues/4246#issuecomment-1799029693
    python3 -m pip uninstall -y apex

#%startscript

%test
    echo "########### PATH VAR #######################"
    echo $PATH

    echo "########### CONDA ENVS #######################"
    source ~/miniconda3/bin/activate
    conda env list

    echo "########### ACTIVATE BASE #######################"
    conda activate base

    echo "########### LIBS IN CONDA BASE #######################"
    conda list

    echo "########### PATHS IN /app #######################"
    ls /app